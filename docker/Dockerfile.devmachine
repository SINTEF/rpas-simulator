# Development tools on top of the existing SEN SDK; no SEN rebuild required.
ARG SEN_BASE=drone_sim/sen-base:05da288e
FROM ${SEN_BASE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker:29.8.1-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker:29.8.1-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --chmod=755 scripts/check_health.py /usr/bin/check_health
ENV PATH=/opt/sen/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CMAKE_PREFIX_PATH=/opt/sen/cmake \
    SEN_PATH=/opt/sen
